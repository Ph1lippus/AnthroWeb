# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
# Both values are baked into the built bundle, so neither can be a secret. Use
# the *publishable* key, never the legacy `anon` JWT and never `service_role` --
# the first is public by design, the second is a full bypass of row level
# security and must never exist in a `VITE_`-prefixed variable, because Vite
# inlines every one of them into `dist/`.
#
# Supabase dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The modern `sb_publishable_...` key. Older projects may only offer the legacy
# `eyJ...` anon key; that one still works, but it is a signed JWT that cannot be
# rotated independently of the others and is worth replacing if you get the chance.
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here